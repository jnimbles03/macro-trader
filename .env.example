# =============================================================================
# Macro Options Scout — environment configuration
# =============================================================================
# Primary synthesis: Grok 4.1 Full (xAI)
# Validator (challenges + fact-checks the primary): Claude Opus
# =============================================================================

# --- Primary LLM (Grok) ----------------------------------------------------
XAI_API_KEY=
GROK_MODEL=grok-4-latest
GROK_BASE_URL=https://api.x.ai/v1
GROK_THINKING=true

# --- Validator LLM (Claude Opus) -------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
EXTENDED_THINKING=true
THINKING_BUDGET_TOKENS=8000

# --- News connectors -------------------------------------------------------
GDELT_ENABLED=true
NEWSAPI_KEY=
REUTERS_API_KEY=

# --- Macro / economic ------------------------------------------------------
FRED_API_KEY=
FMP_API_KEY=

# --- Markets ---------------------------------------------------------------
CME_API_KEY=
CME_API_SECRET=
IBKR_ENABLED=false
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=12

# --- Modes -----------------------------------------------------------------
PAPER_MODE=true
ALLOW_LIVE_TRADING=false
MOCK_DATA=false
ALLOW_0DTE=false

# --- Headline rules --------------------------------------------------------
MAX_HEADLINE_AGE_HOURS=24

# --- Trade rules -----------------------------------------------------------
MIN_SPREAD_RR=2.0
MIN_OPTION_VOLUME=50
MIN_OPEN_INTEREST=100
YOLO_MAX_PREMIUM_DOLLARS=500

# --- Sizing ----------------------------------------------------------------
DEFAULT_ACCOUNT_SIZE=
DEFAULT_RISK_PER_SPREAD_PCT=0.50
DEFAULT_RISK_PER_YOLO_PCT=0.25

# --- Caching (minutes) -----------------------------------------------------
CACHE_HEADLINES_MIN=30
CACHE_REGIME_MIN=60
CACHE_CHAIN_MIN=5

# --- Storage ---------------------------------------------------------------
DB_PATH=./data/macro_scout.db
